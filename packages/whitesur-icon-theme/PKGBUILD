# FeatherOS build of WhiteSur icons (https://github.com/vinceliuice/WhiteSur-icon-theme).
# Trademark clean-up: the Apple logo ("start-here") is replaced by the
# FeatherOS feather, the Finder-face file manager by the folder alternative
# (-a), and icons copying Apple's app icons (Safari, iCloud) are removed.
pkgname=whitesur-icon-theme
pkgver=2026.09.10
pkgrel=2
pkgdesc='macOS-like icon theme (FeatherOS build, Apple logos removed)'
arch=(any)
url='https://github.com/vinceliuice/WhiteSur-icon-theme'
license=(GPL-3.0-or-later)
makedepends=(gtk-update-icon-cache)
_tag=${pkgver//./-}
source=("$pkgname-$_tag.tar.gz::$url/archive/refs/tags/$_tag.tar.gz"
        featheros-logo.svg
        featheros-logo-symbolic.svg)
sha256sums=('406c9cd59705583f1754b0eaca96cc48bafda042b88ef143f16d8ae1820ecd95'
            'SKIP'
            'SKIP')

package() {
  cd "WhiteSur-icon-theme-$_tag"
  local dest="$pkgdir/usr/share/icons"
  install -d "$dest"
  ./install.sh -a -t default -d "$dest"

  cd "$dest"
  # Apple-branded icons out, FeatherOS feather in (at the same paths, so the
  # theme's other links to them keep working).
  find . \( -name 'safari.svg' -o -name 'icloud.svg' -o -name 'tapple.svg' \) -delete
  local f
  while read -r f; do
    rm -f "$f"
    case $f in
      *-symbolic.svg) install -Dm644 "$srcdir/featheros-logo-symbolic.svg" "$f" ;;
      *)              install -Dm644 "$srcdir/featheros-logo.svg" "$f" ;;
    esac
  done < <(find . \( -name 'start-here.svg' -o -name 'start-here-symbolic.svg' \
                    -o -name 'distributor-logo.svg' \) )
  local theme
  for theme in WhiteSur WhiteSur-light WhiteSur-dark; do
    install -Dm644 "$srcdir/featheros-logo.svg" "$theme/apps/scalable/featheros.svg"
    gtk-update-icon-cache -qf "$theme"
  done
  install -Dm644 "$srcdir/WhiteSur-icon-theme-$_tag/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
