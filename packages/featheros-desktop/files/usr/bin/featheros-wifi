#!/bin/sh
# Wi-Fi menu (click the network icon in the top bar). Talks to iwd via iwctl;
# no applet runs in the background.
. /usr/lib/featheros/common.sh

# One menu at a time. Clicking the icon again while the menu is open closes
# it (like macOS) instead of starting a second rofi, which made both vanish.
mkdir -p "$FEATHEROS_CACHE"
exec 9>"$FEATHEROS_CACHE/wifi.lock"
if ! flock -n 9; then
    pkill -u "$(id -u)" -f 'rofi .*-p Wi-Fi'
    exit 0
fi

theme="$FEATHEROS_SHARE/rofi/menu-$MODE.rasi"
square=""
pgrep -u "$(id -u)" -x picom >/dev/null || square='window { border-radius: 0; }'
menu() { rofi -dmenu -i -theme "$theme" -theme-str "window { location: northeast; anchor: northeast; x-offset: -8px; } $square" "$@"; }
say()  { rofi -e "$1" -theme "$theme" -theme-str "window { location: center; anchor: center; } $square"; }
# Password box: the menu theme has no text entry, so use the Spotlight one
# (entry + prompt, no list). Input is masked.
ask_password() {
    rofi -dmenu -password -p "Senha de $1:" \
        -theme "$FEATHEROS_SHARE/rofi/spotlight-$MODE.rasi" \
        -theme-str "inputbar { children: [ prompt, entry ]; } entry { placeholder: \"\"; } listview { lines: 0; } $square" </dev/null
}

dev=$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' |
      awk '$0 ~ /station/ { print $1; exit }')
[ -n "$dev" ] || { say "Nenhum adaptador Wi-Fi encontrado."; exit 0; }

# get-networks columns: [>] SSID  security  signal(****). The SSID may
# contain spaces, so take the last two fields off the end.
networks() {
    iwctl station "$dev" get-networks 2>/dev/null |
        sed 's/\x1b\[[0-9;]*m//g' | sed '1,4d;/^[[:space:]]*$/d' |
        grep -v 'No networks available' |
        awk '{ cur = ($1 == ">") ? "✓ " : "";
               if (cur != "") $1 = "";
               sig = $NF; sec = $(NF-1); $NF = ""; $(NF-1) = "";
               sub(/^ +/, ""); sub(/ +$/, "");
               printf "%s%s\t%s\t%s\n", cur, $0, sec, sig }'
}

# Show what iwd already knows right away (it scans on its own); only wait
# for a fresh scan when it knows nothing yet. Refresh in the background.
list=$(networks)
if [ -z "$list" ]; then
    iwctl station "$dev" scan >/dev/null 2>&1
    sleep 3
    list=$(networks)
else
    iwctl station "$dev" scan >/dev/null 2>&1 &
fi
[ -n "$list" ] || { say "Nenhuma rede Wi-Fi encontrada."; exit 0; }

# Let the click that opened the menu finish: its button release arriving
# after rofi appears counts as a click outside the menu and closes it.
sleep 0.3

# "Desconectar" last and only when connected, so a stray click can't hit it.
choice=$( { echo "$list" | awk -F'\t' 'NF { printf "%-28s %s  %s\n", $1, $3, ($2 == "open" ? "" : "🔒") }'
            case $list in *"✓ "*) echo "Desconectar" ;; esac; } |
          menu -p "Wi-Fi" -format s)
[ -n "$choice" ] || exit 0
if [ "$choice" = Desconectar ]; then
    iwctl station "$dev" disconnect
    exit 0
fi

line=$(echo "$list" | awk -F'\t' -v c="$choice" 'index(c, $1) == 1 { print; exit }')
ssid=$(echo "$line" | cut -f1 | sed 's/^✓ //')
sec=$(echo "$line" | cut -f2)

# Known or open networks connect directly; others ask for the password.
if iwctl known-networks list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -qF "  $ssid  " ||
   [ "$sec" = open ]; then
    if iwctl station "$dev" connect "$ssid"; then say "Conectado a $ssid."
    else say "Não foi possível conectar a $ssid."; fi
else
    pw=$(ask_password "$ssid") || exit 0
    [ -n "$pw" ] || exit 0
    if iwctl --passphrase "$pw" station "$dev" connect "$ssid"; then
        say "Conectado a $ssid."
    else
        say "Não foi possível conectar a $ssid. Verifique a senha."
    fi
fi
