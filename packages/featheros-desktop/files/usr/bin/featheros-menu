#!/bin/sh
# The feather menu in the top-left corner (like the macOS Apple menu).
. /usr/lib/featheros/common.sh

if [ "$MODE" = dark ]; then appearance="Aparência clara"; else appearance="Aparência escura"; fi
if pgrep -u "$(id -u)" -x picom >/dev/null; then effects="Desligar efeitos visuais"
else effects="Ligar efeitos visuais"; fi
if systemctl is-active --quiet sshd.service; then remote="Desligar acesso remoto"
else remote="Ligar acesso remoto"; fi
square=""
pgrep -u "$(id -u)" -x picom >/dev/null || square='window { border-radius: 0; }'

# Live USB: offer the installer; installed system: offer updates.
if [ -d /run/archiso ]; then system="Instalar FeatherOS"; sysicon=drive-harddisk-symbolic
else system="Atualizar sistema"; sysicon=software-update-available-symbolic; fi

choice=$(printf '%s\0icon\x1f%s\n' \
    "Sobre este computador" computer-symbolic \
    "$system" "$sysicon" \
    "$appearance" weather-clear-night-symbolic \
    "$effects" preferences-desktop-display-symbolic \
    "$remote" network-server-symbolic \
    "Encerrar sessão" system-log-out-symbolic \
    "Reiniciar" system-reboot-symbolic \
    "Desligar" system-shutdown-symbolic |
    rofi -dmenu -i -no-custom -format i -p "" \
        -theme "$FEATHEROS_SHARE/rofi/menu-$MODE.rasi" -theme-str "$square")

case $choice in
    0) featheros-about ;;
    1) if [ -d /run/archiso ]; then featheros-terminal --title "Instalar FeatherOS" --geometry=100x30 -x sudo featheros-install
       else featheros-update; fi ;;
    2) featheros-theme toggle ;;
    3) featheros-effects toggle ;;
    4) featheros-remote toggle ;;
    5) openbox --exit ;;
    6) sudo -n systemctl reboot ;;
    7) sudo -n systemctl poweroff ;;
esac
