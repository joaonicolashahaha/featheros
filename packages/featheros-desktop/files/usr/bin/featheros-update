#!/bin/sh
# "Atualizar sistema": update Arch packages and FeatherOS (from your desktop's
# update server) in a terminal window.
if [ -z "$FEATHEROS_IN_TERMINAL" ]; then
    exec env FEATHEROS_IN_TERMINAL=1 featheros-terminal --title "Atualizar sistema" \
        -x featheros-update
fi
echo "Atualizando o FeatherOS (pacman -Syu)..."
echo
sudo pacman -Syu
echo
printf 'Pronto. Pressione Enter para fechar.'
read -r _
