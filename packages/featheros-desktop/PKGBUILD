# FeatherOS desktop: session scripts, themes, artwork and system defaults.
# Everything here is FeatherOS's own; files/ mirrors the target filesystem.
#
# featheros: auto-version
# scripts/build-packages.sh sets pkgver to the build date whenever the
# contents of this directory change, so every change becomes an update that
# installed systems receive with `pacman -Syu`.
pkgname=featheros-desktop
pkgver=0
pkgrel=1
pkgdesc='FeatherOS desktop: macOS-inspired Openbox session, themes and defaults'
arch=(x86_64)
url='https://github.com/'
license=(GPL-3.0-or-later)
# Everything the desktop uses. New dependencies added here reach installed
# systems with the next update.
depends=(
  # X11 session
  xorg-server xorg-xinit xf86-input-libinput xf86-video-intel mesa
  openbox tint2 picom rofi hsetroot xsettingsd xdg-user-dirs
  # Look
  whitesur-gtk-theme whitesur-icon-theme whitesur-cursor-theme
  inter-font ttf-dejavu
  # System
  iwd zram-generator alsa-utils brightnessctl sudo
  pipewire pipewire-pulse pipewire-alsa wireplumber
  # Apps
  pcmanfm xfce4-terminal firefox firefox-i18n-pt-br mpv yt-dlp xclip
  geany neovim python
  # Remote access (off by default): SSH + screenshots + mouse/keyboard
  openssh maim xdotool
  # USB Wi-Fi adapters that start as a "driver CD" (e.g. Realtek 0bda:1a2b)
  usb_modeswitch
  # Wi-Fi regulatory database (Brazil: /etc/modprobe.d/featheros-wifi-regdom.conf)
  wireless-regdb
  # The "Atualizações" app (GTK 3 from Python)
  python-gobject
)
# featheros-dockd (dockd/; not src/, which makepkg owns): the dock's "intelligent hide" helper.
makedepends=(gcc libx11)
options=(!debug)

# Files under /etc: local edits are kept on update (new version -> .pacnew).
backup=($(cd "${BASH_SOURCE[0]%/*}/files" 2>/dev/null && find etc -type f | sort))

build() {
  cc $CFLAGS -Wall -o featheros-dockd "$startdir/dockd/featheros-dockd.c" $LDFLAGS -lX11
}

package() {
  cp -a "$startdir/files/." "$pkgdir/"
  install -Dm755 featheros-dockd "$pkgdir/usr/bin/featheros-dockd"
  chmod 755 "$pkgdir"/usr/bin/* "$pkgdir"/usr/lib/featheros/autostart \
    "$pkgdir"/usr/lib/featheros/wifi-prefer-usb \
    "$pkgdir"/usr/lib/featheros/update-system \
    "$pkgdir"/usr/lib/featheros/warmup \
    "$pkgdir"/etc/skel/.xinitrc
  chmod 644 "$pkgdir"/etc/profile.d/*
  # sudo ignores rule files that are not exactly like this.
  chmod 750 "$pkgdir"/etc/sudoers.d
  chmod 440 "$pkgdir"/etc/sudoers.d/*
}
