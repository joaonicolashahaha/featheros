/* Spotlight-style app search (Super+Space). */
* { bg: #2a2a2c; fg: #ececec; dim: #8e8e93; line: #ffffff26; sel: #3a82f7; selfg: #ffffff; }
@import "base.rasi"
window { location: north; anchor: north; y-offset: 20%; width: 620px; }
/* One string per line: rofi 2.0 mis-parses two quoted strings on one line. */
entry {
    font: "Inter 17";
    placeholder: "Buscar aplicativos";
}
listview { lines: 7; }
