<?xml version="1.0" encoding="UTF-8"?>
<!-- FeatherOS defaults for xfce4-terminal: colours follow the GTK theme
     (so light/dark switching applies), no menu bar (right-click has it). -->
<channel name="xfce4-terminal" version="1.0">
  <property name="font-name" type="string" value="DejaVu Sans Mono 10"/>
  <property name="color-use-theme" type="bool" value="true"/>
  <property name="misc-menubar-default" type="bool" value="false"/>
  <property name="misc-default-geometry" type="string" value="90x26"/>
  <property name="scrolling-lines" type="uint" value="5000"/>
  <property name="misc-cursor-blinks" type="bool" value="false"/>
</channel>
