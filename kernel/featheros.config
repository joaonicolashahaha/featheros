# FeatherOS overrides, applied after `make localmodconfig`.
# Each line is justified by RAM, CPU, boot time or build time on the target
# (Core 2 Duo T6600, 3 GB, GMA 4500M, HDD).

# --- No debug info / tracing: smaller kernel, much faster build, less overhead
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_RUST is not set

# --- Topology: one socket, two cores. Arch's NR_CPUS=320 sizes per-CPU data
#     for 320 CPUs; NUMA is useless on a single-node laptop.
# CONFIG_MAXSMP is not set
CONFIG_NR_CPUS=8
# CONFIG_NUMA is not set

# --- Guest support we don't need (keep KVM/virtio paravirt for the VM)
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
# CONFIG_ACRN_GUEST is not set
# CONFIG_JAILHOUSE_GUEST is not set
# CONFIG_INTEL_TDX_GUEST is not set
# CONFIG_AMD_MEM_ENCRYPT is not set
# CONFIG_X86_SGX is not set

# --- Memory: zram is the swap; zswap on top of it only wastes CPU
# CONFIG_ZSWAP_DEFAULT_ON is not set
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
# Only zstd (default) and lz4 are offered to zram; the other backends would
# load their compressor modules every time zram loads.
# CONFIG_ZRAM_BACKEND_842 is not set
# CONFIG_ZRAM_BACKEND_LZ4HC is not set
# CONFIG_ZRAM_BACKEND_DEFLATE is not set

# --- Transparent hugepages off: with THP enabled the kernel raises
#     min_free_kbytes to ~67 MB on this machine (measured), RAM that can never
#     be used. 2 MB pages bring nothing on a 3 GB desktop with an HDD.
CONFIG_TRANSPARENT_HUGEPAGE_NEVER=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set

# --- HDD: BFQ built in (selected by a udev rule for rotational disks)
CONFIG_IOSCHED_BFQ=y

# --- Sound: since 6.17 the Realtek HDA codec is split per chip. The laptop's
#     lsmod (older kernel) says "snd_hda_codec_realtek", which no longer
#     matches anything, so enable every Realtek variant explicitly.
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_ALC260=m
CONFIG_SND_HDA_CODEC_ALC262=m
CONFIG_SND_HDA_CODEC_ALC268=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_HDA_CODEC_ALC662=m
CONFIG_SND_HDA_CODEC_ALC680=m
CONFIG_SND_HDA_CODEC_ALC861=m
CONFIG_SND_HDA_CODEC_ALC861VD=m
CONFIG_SND_HDA_CODEC_ALC880=m
CONFIG_SND_HDA_CODEC_ALC882=m
# HDMI codec: GM45 has HDMI/DisplayPort output on some boards
CONFIG_SND_HDA_CODEC_HDMI=m

# --- GPU: GMA 4500M (i915) + its AGP/GTT helpers; framebuffer console fallback
CONFIG_DRM_I915=m
CONFIG_AGP=y
CONFIG_AGP_INTEL=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Wi-Fi regulatory database is loaded from /lib/firmware
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
